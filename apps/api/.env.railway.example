# ==============================================================================
# RAILWAY PRODUCTION ENVIRONMENT VARIABLES
# ==============================================================================

# Server Network Configuration (Injected dynamically by Railway)
PORT=8000
ENVIRONMENT=production

# Database Connection (Provided automatically by Railway PostgreSQL plugin)
# Format: postgresql://postgres:<password>@<host>:<port>/railway
DATABASE_URL=postgresql://postgres:password@postgres.railway.internal:5432/railway

# Cache & Message Broker (Provided automatically by Railway Redis plugin)
# Format: redis://default:<password>@<host>:<port>
REDIS_URL=redis://default:password@redis.railway.internal:6379

# Celery Worker Broker (Uses the same Redis instance)
CELERY_BROKER_URL=redis://default:password@redis.railway.internal:6379/0

# Security & Authentication
# 32+ character high-entropy secret key for signing JWT tokens
JWT_SECRET=production-grade-super-secret-jwt-key-change-me-32-chars

# Base URL for public redirect links (points to the Railway public service domain)
BASE_URL=https://link-shortener-production.up.railway.app

