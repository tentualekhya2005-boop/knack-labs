# ==============================================================================
# ENVIRONMENT CONFIGURATION TEMPLATE
# Copy to .env and adjust for local or production use
# ==============================================================================

# Application Network Port
PORT=8000

# Environment mode: development | test | production
ENVIRONMENT=development

# Base URL for public redirect links
BASE_URL=http://localhost:8000

# PostgreSQL Database Connection
# Format: postgresql://<user>:<password>@<host>:<port>/<dbname>
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/linkshortener

# Redis Connection (Cache and Message Broker)
# Format: redis://[default:<password>@]<host>:<port>/<db_index>
REDIS_URL=redis://localhost:6379/0

# Celery Worker Message Broker
CELERY_BROKER_URL=redis://localhost:6379/0

# JWT Authentication Secret (Generate a 32+ character high-entropy key)
# e.g., openssl rand -hex 32
JWT_SECRET=your-random-32-character-secret-key-change-this

# Optional API Keys for testing
API_KEY_A=optional-test-api-key-a
API_KEY_B=optional-test-api-key-b

